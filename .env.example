# Example environment variables for User Management Portal backend
# Copy this to .env and edit values as needed

# Server port
PORT=3000

# JWT configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES=1d

# Database (using sqlite by default; adjust if you use another dialect)
# For sqlite, you might set a file path or use in-memory for tests
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

